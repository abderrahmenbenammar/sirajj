# Database (Supabase)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Auth
AUTH_SECRET="replace-with-a-64-char-random-hex-string"
APP_URL="http://localhost:3000"

# YouTube Data API (server-only): lesson video lengths for automatic course
# durations. Without a key, YouTube lessons resolve to unknown length and are
# excluded from totals. Never exposed to the browser.
YOUTUBE_API_KEY=""

# Gemini AI (matn grading and assisted quiz generation)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# SMTP (optional — password reset emails won't send without this)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SIRAJ <no-reply@example.com>"
